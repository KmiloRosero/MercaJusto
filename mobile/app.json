{
  "expo": {
    "name": "MercaJusto",
    "slug": "mercajusto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mercajusto",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.mercajusto.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MercaJusto usa la cámara para que tomes fotos de tus cosechas.",
        "NSPhotoLibraryUsageDescription": "MercaJusto accede a tus fotos para que publiques imágenes de tus cosechas.",
        "NSLocationWhenInUseUsageDescription": "MercaJusto usa tu ubicación para registrar direcciones de entrega y la ubicación de tu finca."
      }
    },
    "android": {
      "package": "co.mercajusto.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F6B3D"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "MercaJusto",
      "themeColor": "#1F6B3D"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1F6B3D"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MercaJusto usa tu ubicación para registrar direcciones de entrega y la ubicación de tu finca."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MercaJusto accede a tus fotos para que publiques imágenes de tus cosechas.",
          "cameraPermission": "MercaJusto usa la cámara para que tomes fotos de tus cosechas.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F6B3D"
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "788dc40f-72a0-40f4-91c7-77ab8645d576"
      }
    },
    "owner": "kmilorosero",
    "updates": {
      "url": "https://u.expo.dev/788dc40f-72a0-40f4-91c7-77ab8645d576"
    }
  }
}
