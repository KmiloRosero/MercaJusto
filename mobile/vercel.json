{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/producto/:id", "destination": "/producto/[id]" },
    { "source": "/seguimiento/:id", "destination": "/seguimiento/[id]" },
    { "source": "/calificacion/:id", "destination": "/calificacion/[id]" },
    { "source": "/productor/:id", "destination": "/productor/[id]" }
  ]
}