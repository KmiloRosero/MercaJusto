{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/producto/:id", "destination": "/producto/[id].html" },
    { "source": "/seguimiento/:id", "destination": "/seguimiento/[id].html" },
    { "source": "/calificacion/:id", "destination": "/calificacion/[id].html" }
  ]
}