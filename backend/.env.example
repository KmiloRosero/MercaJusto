# Puerto del servidor
PORT=4000

# Base de datos — SQLite para desarrollo local.
# Para migrar a Postgres+PostGIS (fase de rutas geográficas):
#   1) Cambia provider = "postgresql" en prisma/schema.prisma
#   2) docker compose up -d (usa backend/docker-compose.yml)
#   3) Cambia esta URL por: postgresql://mercajusto:mercajusto@localhost:5432/mercajusto?schema=public
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="cambia-esto-en-produccion-usa-un-string-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# OTP simulado — en producción usar Twilio/WhatsApp Business API
OTP_TTL_SECONDS=300
OTP_DEV_MODE=true
OTP_DEV_CODE="123456"

# CORS
CORS_ORIGIN="*"

# URL pública base del backend — se usa para construir las URLs de las fotos
# subidas (POST /api/uploads). En un dispositivo/emulador apunta a la IP LAN de
# tu máquina (ej. http://192.168.0.10:4000); en producción, tu dominio HTTPS.
PUBLIC_URL="http://localhost:4000"

# Centro de distribución / punto de partida de los repartidores (VRP).
# Si se omite, el optimizador usa el centroide de las paradas del día.
# Ejemplo: centro de acopio en Pasto.
DEPOT_LAT="1.2136"
DEPOT_LNG="-77.2811"
