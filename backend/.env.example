# Copia este archivo como .env para desarrollo local.

PORT=4000

# Base de datos: Postgres local con `docker compose up -d`.
# En producción, la connection string de Neon (con ?sslmode=require).
DATABASE_URL="postgresql://mercajusto:mercajusto@localhost:5432/mercajusto?schema=public"

# JWT: en producción, un texto largo y aleatorio (Render lo genera solo).
JWT_SECRET="cambia-esto-por-un-texto-largo-y-aleatorio"
JWT_EXPIRES_IN="30d"

# Códigos de acceso por correo con Brevo (gratis: 300 correos al día).
# MAIL_FROM_EMAIL tiene que estar verificado en Brevo → Senders.
BREVO_API_KEY=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="MercaJusto"
# Solo local, sin correo: la app muestra el código en pantalla. Se ignora en producción.
OTP_DEV_MODE=true

# Fotos en Cloudinary. Si faltan, se guardan en ./uploads (solo sirve en local).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Pagos en línea con Wompi (llaves de pruebas: pub_test_..., prv_test_...).
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
# Minutos que se reserva el stock mientras el comprador paga.
PAYMENT_WINDOW_MIN=30

# CORS
CORS_ORIGIN="*"

# URL pública del backend: fotos locales y regreso desde Wompi.
# Si se omite, se usa el host de cada petición (sirve en red local).
# PUBLIC_URL="https://mercajusto-backend.onrender.com"
# Orígenes web a los que se puede volver después de pagar (separados por coma).
# APP_WEB_ORIGINS="https://mercajusto.vercel.app"

# Punto de partida de los repartidores para el optimizador de rutas.
DEPOT_LAT="1.2136"
DEPOT_LNG="-77.2811"
